# Native Android/iOS calls official EGO HTTPS endpoints directly by default.
# Web development uses the Expo host's LAN address and port 8787 automatically.
# Optionally route all platforms through a deployed HTTPS proxy, then rebuild.
# EXPO_PUBLIC_TRANSPORT_API_URL=https://your-transport-service.example

# Server only: optionally restrict web callers to your application's origin.
# ALLOWED_ORIGIN=https://your-web-app.example
# PORT=8787
